{% block sas_esd_serial_overview %}
    <div>
        <div
            v-if="!isLoading && serials && serials.length > 0"
            class="sas-esd-serial-overview"
        >
            {% block  sas_esd_serial_overview_option_list_toolbar %}
            <div class="sw-configuration-option-list__toolbar">
                {% block  sas_esd_serial_overview_option_list_toolbar_container %}
                <sw-container
                    columns="1fr minmax(50px, max-content) minmax(100px, 180px) minmax(100px, 180px)"
                    gap="0 10px"
                >
                    {% block  sas_esd_serial_overview_option_list_toolbar_buttons %}
                    <mt-button
                        ghost
                        variant="primary"
                        @click="openModal('serialModal')"
                    >
                        {{ $tc('sas-esd.serialModal.buttonOpen') }}
                    </mt-button>
                    <mt-button
                        ghost
                        variant="primary"
                        @click="openModal('csvModal')"
                    >
                        {{ $tc('sas-esd.sas-esd-modal-csv.buttonImport') }}
                    </mt-button>
                    {% endblock %}
                </sw-container>
                {% endblock %}
            </div>
            {% endblock %}

        {% block sas_esd_serial_overview_data_grid %}
            <sw-data-grid
                class="sas-esd-serial-overview__data-grid"
                :data-source="serials"
                :columns="serialColumns"
                :is-loading="isLoading"
                :show-settings="true"
                :sort-by="sortBy"
                :sort-direction="sortDirection"
                identifier="sas-esd-overview"
                @column-sort="onSortColumn"
                @selection-change="onSelectionChanged"
            >
                {% block sw_product_variants_overview_data_grid_column_stock %}
                <template
                    #column-esdOrder.orderLineItem.order.orderCustomer.firstName="{ item }"
                >
                    <span v-if="item.esdOrder">
                        <router-link
                            :to="{ name: 'sw.customer.detail', params: { id: item.esdOrder.orderLineItem.order.orderCustomer.customerId } }"
                        >
                            {{ item.esdOrder.orderLineItem.order.orderCustomer.firstName }}
                            {{ item.esdOrder.orderLineItem.order.orderCustomer.lastName }}
                        </router-link>
                    </span>
                </template>
                {% endblock %}

                {% block sas_esd_serial_overview_data_grid_action_modals %}
                <template #action-modals="{ item }">
                    <sw-modal
                        v-if="showDeleteModal === item.id"
                        :title="$tc('sas-esd.serial.deleteModalTitle')"
                        variant="small"
                        @modal-close="onCloseDeleteModal"
                    >
                        <p
                            class="sw-product-variants-overview__modal--confirm-delete-text"
                        >
                            {{ $tc('sas-esd.serial.deleteModalMessage') }}
                        </p>
                        <template #modal-footer>
                            {% block sw_product_variants_overview_data_grid_action_modals_buttons %}
                            <mt-button
                                size="small"
                                :disabled="modalLoading"
                                @click="onCloseDeleteModal"
                            >
                                {{ $tc('global.default.cancel') }}
                            </mt-button>
                            <mt-button
                                variant="primary"
                                size="small"
                                :disabled="modalLoading"
                                @click="onConfirmDelete(item)"
                            >
                                {{ $tc('global.default.delete') }}
                            </mt-button>
                            {% endblock %}
                        </template>
                    </sw-modal>
                </template>

                <template #bulk-modals>
                    <sw-modal
                        v-if="showDeleteListModal"
                        key="modalDeleteList"
                        :title="$tc('sas-esd.serial.deleteModalTitle')"
                        variant="small"
                        @modal-close="onCloseDeleteModal"
                    >
                        <p
                            class="sw-product-variants-overview__modal--confirm-delete-text"
                        >
                            {{ $tc('sas-esd.serial.deleteModalMessage') }}
                        </p>
                        <template #modal-footer>
                            <slot name="bulk-modal-cancel">
                                <mt-button
                                    size="small"
                                    :disabled="modalLoading"
                                    @click="showDeleteListModal = false"
                                >
                                    {{ $tc('global.default.cancel') }}
                                </mt-button>
                            </slot>
                            <slot name="bulk-modal-delete-items">
                                <mt-button
                                    variant="primary"
                                    size="small"
                                    :disabled="modalLoading"
                                    @click="onConfirmDeleteItems()"
                                >
                                    {{ $tc('global.default.delete') }}
                                </mt-button>
                            </slot>
                        </template>
                    </sw-modal>
                </template>
                {% endblock %}

                {% block sas_esd_serial_overview_data_grid_actions %}
                <template #actions="{ item }">
                    {% block sas_esd_serial_overview_data_grid_actions_items %}
                    <sw-context-menu-item
                        variant="danger"
                        @click="onEsdDelete(item)"
                    >
                        {{ $tc('sas-esd.contextMenuDelete') }}
                    </sw-context-menu-item>
                    {% endblock %}
                </template>
                {% endblock %}

                {% block ssas_esd_serial_overview_data_grid_pagination %}
                <template #pagination>
                    <sw-pagination
                        :page="page"
                        :limit="limit"
                        :total="total"
                        :total-visible="7"
                        @page-change="onPageChange"
                    />
                </template>
                {% endblock %}
                <template #bulk>
                    <button
                        class="link link-danger"
                        @keypress.enter="showDeleteListModal = true"
                        @click="showDeleteListModal = true"
                    >
                        {{ $tc('global.default.delete') }}
                    </button>
                </template>
            </sw-data-grid>
            {% endblock %}
        </div>
        {% block sas_esd_serial_overview_empty_state %}
        <div v-else>
            <div class="sas-esd-serial-overview__empty-state-inner">
                <img
                    alt="Empty state image"
                    :src="assetFilter('/administration/administration/static/img/empty-states/products-empty-state.svg')"
                >
                <div class="sas-esd-serial-overview__empty-state-inner--label">
                    <p>
                        {{ $tc('sas-esd.emptyStateSerialDescription') }}
                    </p>
                </div>
                {% block sas_product_detail_esd_add %}
                <sw-button-group>
                    <mt-button
                        :disabled="false"
                        ghost
                        variant="primary"
                        @click="openModal('serialModal')"
                    >
                        {{ $tc('sas-esd.serialModal.buttonOpen') }}
                    </mt-button>
                    <mt-button
                        :disabled="false"
                        ghost
                        variant="primary"
                        @click="openModal('csvModal')"
                    >
                        {{ $tc('sas-esd.sas-esd-modal-csv.buttonImport') }}
                    </mt-button>
                </sw-button-group>
                {% endblock %}
            </div>
        </div>
        {% endblock %}

    {% block sas_product_detail_esd_modal_serial %}
        <sas-esd-modal-serial
            v-if="activeModal === 'serialModal'"
            @load-product="loadProduct"
            @modal-close="updateSerials"
            @serial-updated="updateSerials"
        />
        {% endblock %}

    {% block sas_product_detail_esd_modal_csv %}
        <sas-esd-modal-csv
            v-if="activeModal === 'csvModal'"
            v-model:value="csv"
            :esd-id="product.extensions.esd.id"
            :map-fields="{serial: 'Serial'}"
            @load-product="loadProduct"
            @serial-updated="updateSerials"
            @modal-close="updateSerials"
        />
        {% endblock %}
    </div>
{% endblock %}
