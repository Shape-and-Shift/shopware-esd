{% block sw_order_detail_details_custom_fields %}
    <mt-card
        v-if="transaction.stateMachineState.technicalName === 'paid' && (isEnableDownloadButton || isEnableSerialButton)"
        :title="$tc('sas-esd.esdMail.cardTitle')"
        position-identifier="sas-sw-order-detail-base__document"
        :is-loading="isLoading"
    >
        <sw-container
            columns="1fr 1fr"
            gap="10px"
        >
            <mt-button
                size="small"
                variant="primary"
                :disabled="!isEnableDownloadButton || isSendMailLoading"
                @click="onSendDownloadMail"
            >
                {{ $tc('sas-esd.esdMail.sendMailDownload') }}
            </mt-button>
            <mt-button
                size="small"
                variant="primary"
                :disabled="!isEnableSerialButton || isSendMailLoading"
                @click="onSendSerialMail"
            >
                {{ $tc('sas-esd.esdMail.sendMailSerial') }}
            </mt-button>
        </sw-container>
    </mt-card>

    {% parent() %}
{% endblock %}